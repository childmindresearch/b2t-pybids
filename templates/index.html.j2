<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PyBIDS → bids2table Migration Guide</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-white p-5">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <header class="bg-gradient-to-r from-blue-50 to-indigo-50 p-8 text-center rounded-lg mb-8 shadow-sm">
      <div class="flex items-center justify-center mb-4">
        <img src="https://raw.githubusercontent.com/marimo-team/marimo/main/docs/_static/marimo-logotype-thick.svg" alt="marimo Logo" class="w-16 h-auto mr-4">
        <h1 class="text-3xl font-bold text-gray-900">PyBIDS → bids2table</h1>
      </div>
      <p class="text-lg text-gray-700 mb-2">Interactive Migration Guide</p>
      <p class="text-sm text-gray-600">Compare PyBIDS vs bids2table with live examples and real BIDS data</p>
      <div class="mt-4">
        <a href="https://github.com/childmindresearch/b2t-pybids" target="_blank" class="inline-block bg-gray-800 hover:bg-gray-700 text-white py-2 px-4 rounded-md transition-colors text-sm">
          <svg class="inline-block w-4 h-4 mr-2 -mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          View on GitHub
        </a>
      </div>
    </header>

    <main>
      {% if apps %}
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-center mb-3 text-gray-900">Migration Guides</h2>
        <p class="text-center mb-6 text-gray-600">Interactive demos showing how to migrate from PyBIDS to bids2table</p>
        <div class="grid grid-cols-1 gap-4">
          {% for app in apps %}
          <div class="bg-white border-2 border-gray-200 rounded-lg overflow-hidden hover:border-indigo-300 transition-colors shadow-sm">
            <div class="bg-gradient-to-r from-indigo-500 to-blue-500 p-4 text-white">
              <h3 class="font-bold text-lg">{{ app.display_name }}</h3>
            </div>
            <div class="p-6">
              <ul class="text-sm text-gray-600 mb-4 space-y-2">
                <li>✓ Compare 4 approaches side-by-side</li>
                <li>✓ See live code examples with real BIDS data</li>
                <li>✓ Performance benchmarks included</li>
                <li>✓ Works entirely in your browser</li>
              </ul>
              <a href="{{ app.html_path }}" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-6 rounded-md transition-colors font-medium">
                Open Interactive Guide →
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if notebooks %}
      <section>
        <h2 class="text-2xl font-bold text-center mb-3 text-gray-900">Additional Notebooks</h2>
        <p class="text-center mb-6 text-gray-600">Editable notebooks for deeper exploration</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {% for notebook in notebooks %}
          <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden hover:border-blue-300 transition-colors">
            <div class="bg-gray-700 p-3 font-semibold text-white text-sm">{{ notebook.display_name }}</div>
            <div class="p-4">
              <a href="{{ notebook.html_path }}" class="inline-block bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-md transition-colors text-sm">
                Open Notebook
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- Key Benefits Section -->
      <section class="mt-10 p-6 bg-green-50 rounded-lg border border-green-200">
        <h3 class="text-xl font-bold mb-4 text-green-900">Why Migrate?</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div>
            <div class="font-bold text-green-800 mb-1">⚡ 20x Faster</div>
            <div class="text-gray-700">Dataset indexing is dramatically faster with bids2table</div>
          </div>
          <div>
            <div class="font-bold text-green-800 mb-1">🔄 Drop-in Replacement</div>
            <div class="text-gray-700">Minimal code changes with the compatibility layer</div>
          </div>
          <div>
            <div class="font-bold text-green-800 mb-1">🐼 Modern API</div>
            <div class="text-gray-700">Built on DataFrames instead of SQLite</div>
          </div>
        </div>
      </section>
    </main>

    <footer class="mt-10 pt-6 border-t border-gray-200 text-center text-sm text-gray-600">
      <p class="mb-2">Built with <a href="https://marimo.io" target="_blank" class="text-blue-500 hover:underline">marimo</a> - Interactive Python notebooks</p>
      <p class="text-xs text-gray-500">Part of the <a href="https://github.com/childmindresearch" target="_blank" class="text-blue-500 hover:underline">Child Mind Institute</a> neuroimaging tools</p>
    </footer>
  </div>
</body>
</html>
